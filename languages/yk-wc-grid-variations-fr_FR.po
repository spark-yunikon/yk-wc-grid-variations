msgstr "Couleur de la pastille"

#: includes/class-yk-wcgv-term-meta.php:124
#: includes/class-yk-wcgv-term-meta.php:147
msgid "Swatch image"
msgstr "Image de la pastille"

#: includes/class-yk-wcgv-term-meta.php:181
msgid "Primary colour"
msgstr "Couleur principale"

#: includes/class-yk-wcgv-term-meta.php:188
msgid "Second colour (two-tone)"
msgstr "Seconde couleur (bicolore)"

#: includes/class-yk-wcgv-term-meta.php:192
msgid "Single colour"
msgstr "Couleur unique"

#: includes/class-yk-wcgv-term-meta.php:200
msgid ""
"Single colour (#000000) or two-tone, comma separated "
"(#000000,#ffcc00). Leave empty to fall back to the built-in "
"colour-name map."
msgstr ""
"Couleur unique (#000000) ou bicolore, séparées par une virgule "
"(#000000,#ffcc00). Laisser vide pour revenir à la table de noms de "
"couleurs intégrée."

#: includes/class-yk-wcgv-term-meta.php:224
msgid "Select image"
msgstr "Sélectionner une image"

#: includes/class-yk-wcgv-term-meta.php:227
msgid "Remove"
msgstr "Supprimer"

#: includes/class-yk-wcgv-term-meta.php:231
msgid "An image takes precedence over the colour above."
msgstr "Une image est prioritaire sur la couleur ci-dessus."

#: includes/class-yk-wcgv-term-meta.php:316
msgid "Swatch"
msgstr "Pastille"

#: includes/class-yk-wcgv-term-meta.php:356
msgid "No swatch set"
msgstr "Aucune pastille définie"

